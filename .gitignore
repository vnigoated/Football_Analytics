# =====================================================================
# PitchLens .gitignore
# Rule of thumb: code, configs and docs go in git; data, media,
# model weights, experiment outputs and secrets never do.
# =====================================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
pip-wheel-metadata/
share/python-wheels/
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/
.python-version
.conda/
conda-env/

# ---------- Testing / linting / type checking ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# ---------- Jupyter / Colab ----------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py
sample_data/

# ---------- Datasets (download with scripts, never commit) ----------
/data/
/datasets/
SoccerNet/
SN-GSR-*/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.npz
*.npy
*.jsonl
*.csv

# ---------- Video / broadcast footage (copyrighted) ----------
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.m4v
*.ts

# ---------- Model weights / checkpoints ----------
weights/
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.trt
*.safetensors
*.bin
*.tflite
*.pb

# ---------- Experiment outputs & logs ----------
outputs/
/results/
runs/
wandb/
mlruns/
lightning_logs/
tb_logs/
logs/
*.log

# ---------- Caches ----------
.cache/
.huggingface/
hf_cache/
.kloppy_cache/

# ---------- Secrets / credentials ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials*.json
kaggle.json
.netrc

# ---------- Editors / IDEs ----------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ---------- Claude Code local settings ----------
.claude/settings.local.json

# ---------- OS files ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Allow-list: tiny test fixtures may be committed ----------
!tests/fixtures/
!tests/fixtures/**

# arXiv build output (generated by paper/make_arxiv.py)
paper/main.bbl
